<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_forsah_opportunities" model="ir.module.category">
        <field name="name">Forsah Opportunities</field>
    </record>

    <record id="group_forsah_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_forsah_opportunities"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_forsah_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_forsah_opportunities"/>
        <field name="implied_ids" eval="[(4, ref('group_forsah_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
